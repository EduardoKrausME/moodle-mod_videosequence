{{!
    @template mod_videosequence/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videosequence-report">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2>{{#str}}
        report, videosequence{{/str}}: {{name}}</h2><a class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}
        backtoactivity, videosequence{{/str}}</a></div>
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}noreportdata, videosequence{{/str}}</div>{{/hasrows}}
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{#str}}student, videosequence{{/str}}</th>
                    <th>{{#str}}watched, videosequence{{/str}}</th>
                    <th>{{#str}}attempts, videosequence{{/str}}</th>
                    <th>{{#str}}submittedsequence, videosequence{{/str}}</th>
                    <th>{{#str}}correctsteps, videosequence{{/str}}</th>
                    <th>{{#str}}grade{{/str}}</th>
                    <th>{{#str}}status, videosequence{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td><strong>{{fullname}}</strong><br><small>{{email}}</small></td>
                        <td>{{percent}}</td>
                        <td>{{attempts}}</td>
                        <td>{{sequence}}</td>
                        <td>{{correct}}</td>
                        <td>{{grade}}</td>
                        <td>{{status}}</td>
                    </tr>{{/rows}}
                </tbody>
            </table>
        </div>{{/hasrows}}
</div>
